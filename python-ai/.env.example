# Python AI Service Environment
# Copy to .env and adjust for your deployment

PORT=8000
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated). Use '*' for dev, specific origins in production.
CORS_ORIGINS=*

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=12

# Max decoded image dimension (px) to prevent memory bombs
MAX_IMAGE_DIMENSION=4096

# Optional: enable Real-ESRGAN super-resolution (CPU, heavy). Set to "true" only if resources allow.
ENABLE_REALESRGAN=false
