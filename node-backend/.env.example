# Node.js Backend Environment
# Copy to .env and adjust for your deployment

PORT=3000
NODE_ENV=development

# Python FastAPI service URL (required in production)
# For local dev: http://localhost:8000
# For Render: https://your-python-service.onrender.com
PYTHON_API_URL=http://localhost:8000

# Frontend allowed origin (CORS). Use '*' for dev, specific origin in production.
FRONTEND_ORIGIN=*

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=12

# Max decoded image dimension (px) to prevent memory bombs
MAX_IMAGE_DIMENSION=4096

# Python request timeout in seconds
PYTHON_REQUEST_TIMEOUT_SECONDS=120
